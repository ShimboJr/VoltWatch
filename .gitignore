# ── Secrets (NEVER commit these) ──────────────────────────────────────────────
.env
.env.local
.env.*.local
**/.env
**/.env.local

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnp
.pnp.js

# ── Build artefacts ───────────────────────────────────────────────────────────
dist/
build/
.next/
out/

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Python (agent) ────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
.Python
*.egg-info/
*.egg
.eggs/
dist/
pip-wheel-metadata/
.venv/
venv/
env/
.env/           # Python virtualenv named env (different from .env file — keep both)
*.spec          # PyInstaller spec (commit only if intentional)

# ── Python PyInstaller output ─────────────────────────────────────────────────
agent/dist/
agent/build/
agent/*.exe
agent/*.spec

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

