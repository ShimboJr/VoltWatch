# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/voltwatch?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── Owner account (seeded on first start) ────────────────────────────────────
OWNER_EMAIL=owner@example.com
# Generate with: npm run hash-password yourpassword
OWNER_PASSWORD_HASH=$argon2id$v=19$...

# ─── Application ──────────────────────────────────────────────────────────────
# Used for: CORS, push notification links, and email verification URLs.
APP_ORIGIN=https://your-dashboard.vercel.app
RETENTION_DAYS=30

# --- Web Push / PWA (Prompt 09) ---------------------------------------------------
# Generate once: node scripts/gen-vapid.js  (safe to commit PUBLIC key only)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# Email (Brevo) — sign up at https://app.brevo.com and create an API key under Settings → API Keys
BREVO_API_KEY=
FROM_EMAIL=noreply@voltwatch-dashboard.vercel.app
FROM_NAME=VoltWatch